# Used by docker-compose.yml to inject environment variables into the
# server container. Copy this to .env in the project root before running
# `docker compose up`.

CLIENT_URL=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_too_please

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
